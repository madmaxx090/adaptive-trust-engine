# Credentials for the postgres service (used by Docker Compose).
POSTGRES_USER=ate
POSTGRES_PASSWORD=ate_dev_password
POSTGRES_DB=ate

# Host-machine defaults. Docker Compose overrides the hostnames with the
# `postgres` and `redis` service names for the api container.
DATABASE_URL=postgresql+psycopg2://ate:ate_dev_password@localhost:5432/ate
REDIS_URL=redis://localhost:6379/0

# Offline GeoLite2 database file (placed manually; never auto-downloaded).
GEOIP_DB_PATH=data/geoip/GeoLite2-City.mmdb

# Trained Isolation Forest artifact for the live ML signal.
ML_MODEL_PATH=ml_model/isolation_forest_v1.joblib
